# Server
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Supabase (server-only). Leave empty to use the mock store.
# Project Settings → API: Project URL + service_role key. Never put service_role in the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upload limits
MAX_UPLOAD_MB=8
